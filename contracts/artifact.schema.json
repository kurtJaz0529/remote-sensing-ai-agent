{
  "type": "object",
  "properties": {
    "schema_revision": {
      "const": "0.1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "data",
        "project",
        "reproducible_package",
        "screenshot",
        "docx",
        "pdf",
        "log",
        "check"
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "verified": {
      "type": "boolean"
    },
    "capture": {
      "type": "object",
      "properties": {
        "software": {
          "type": "string",
          "minLength": 1
        },
        "software_version": {
          "type": "string",
          "minLength": 1
        },
        "window_title": {
          "type": "string",
          "minLength": 1
        },
        "process_id": {
          "type": "integer",
          "minimum": 1
        },
        "layer_or_file": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "displayed_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "displayed_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity_check": {
          "const": "passed"
        },
        "capture_kind": {
          "enum": [
            "operation",
            "result_display"
          ]
        }
      },
      "required": [
        "software",
        "software_version",
        "window_title",
        "process_id",
        "layer_or_file",
        "captured_at",
        "displayed_artifact_id",
        "displayed_artifact_sha256",
        "identity_check",
        "capture_kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_revision",
    "artifact_id",
    "run_id",
    "step_id",
    "kind",
    "relative_path",
    "sha256",
    "size",
    "verified"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsagent:artifact:0.1.0",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "screenshot"
          }
        }
      },
      "then": {
        "required": [
          "capture"
        ]
      }
    }
  ]
}
