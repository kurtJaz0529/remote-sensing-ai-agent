{
  "type": "object",
  "properties": {
    "schema_revision": {
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "from_role": {
      "enum": [
        "local_codex",
        "cloud_codex",
        "gemini_antigravity"
      ]
    },
    "to_role": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "string",
      "minLength": 1
    },
    "base_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_manifest": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "result_summary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "properties": {
        "static_or_mock": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "real_software_run_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_manifest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "static_or_mock",
        "real_software_run_ids",
        "evidence_manifest"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_revision",
    "task_id",
    "from_role",
    "to_role",
    "status",
    "spec_revision",
    "base_version",
    "artifact_manifest",
    "input_refs",
    "changed_files",
    "result_summary",
    "validation",
    "limitations",
    "open_questions",
    "next_action"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsagent:handoff:0.1.0"
}
