{
  "type": "object",
  "properties": {
    "schema_revision": {
      "const": "0.1.0"
    },
    "experience_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "phenomenon": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reproduction_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "fix_comparison_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "regression_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "reviewer_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "author_role": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "reproduced",
        "fix_verified",
        "published",
        "withdrawn"
      ]
    },
    "supersedes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "required": [
    "schema_revision",
    "experience_id",
    "revision",
    "phenomenon",
    "scope",
    "evidence_run_ids",
    "reproduction_run_ids",
    "fix_comparison_run_ids",
    "regression_run_ids",
    "reviewer_role",
    "author_role",
    "status",
    "supersedes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsagent:experience:0.1.0"
}
