{
  "type": "object",
  "properties": {
    "schema_revision": {
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "input_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "acceptance_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "requirement_id",
          "source_locator",
          "description",
          "required_artifacts",
          "acceptance_checks",
          "confidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "method_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "tool_version": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object"
          },
          "dataset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "output_dir": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "implementation_kind": {
            "enum": [
              "native",
              "reimplementation",
              "approximation",
              "mock"
            ]
          },
          "required_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "step_id",
          "depends_on",
          "tool",
          "tool_version",
          "parameters",
          "dataset_ids",
          "output_dir",
          "timeout_seconds",
          "implementation_kind",
          "required_kinds"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "required_deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evaluation_kind": {
      "enum": [
        "unknown",
        "diagnostic",
        "reference_agreement",
        "independent"
      ]
    },
    "frozen_versions": {
      "type": "object"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_identical_error_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "model_cost_limit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "max_tool_calls",
        "max_identical_error_retries",
        "model_cost_limit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_revision",
    "task_id",
    "revision",
    "objective",
    "input_manifest_hash",
    "requirements",
    "method_plan",
    "required_deliverables",
    "assumptions",
    "open_questions",
    "conflicts",
    "evaluation_kind",
    "frozen_versions",
    "budget"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsagent:task:0.1.0"
}
